
<% if(msg && msg.length){ %>
 <div class="alert alert-info alert-dismissible fade show col-lg-6 offset-lg-3 col-12 offset-0" role="alert">
  <%= msg %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
 </div>
<% } %>


<% if(error && error.length){ %>
 <div class="alert alert-danger alert-dismissible fade show  col-lg-6 offset-lg-3 col-12 offset-0" role="alert">
  <%= error %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
 </div>
<% } %>